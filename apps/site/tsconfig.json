{
  // The player page's scripts, which bundle.ts bundles from what tsc writes. build.ts,
  // bundle.ts, demos.ts, facts.ts, guide.ts and astro.config.ts are node's, checked by the
  // root tsconfig; astro/ is Astro's.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/js",
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/context3d/tsconfig.webgl.json" },
    { "path": "../../packages/format" },
    { "path": "../../packages/web" }
  ]
}
