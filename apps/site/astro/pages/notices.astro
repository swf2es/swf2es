---
// The licences of what the site serves, and the files each covers, which
// the build finds by their headers.

import { base, facts } from "../site.ts";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const { build, blob, avmplusSource, avmplusCommit, mpl, ruffle } = facts;
const licence = (file: string) => `${base}licenses/${file}`;
const sourceUrl = (file: string) => `${blob}${file}`;
---

<StarlightPage
  frontmatter={{
    title: "Licences",
    description: "Licences and notices of what the swf2es site serves.",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>
    This site is built from the <a href="https://github.com/swf2es/swf2es">swf2es repository</a>
    at <code>{build}</code>. Its scripts are served as they were compiled, their comments and
    the notices in them kept. The source of every file below is in the repository at that commit.
  </p>

  <h2>swf2es</h2>
  <p>Apache License 2.0. <a href={licence("swf2es-Apache-2.0.txt")}>Licence text</a>.</p>

  <h2>avmplus: builtin.abc and translated files</h2>
  <p>
    <code>libraries/builtin.abc</code>, ActionScript 3's standard library, is generated by
    <a href="https://github.com/adobe/avmplus">avmplus</a>, and the files of swf2es listed below
    are translated from avmplus. They are subject to the Mozilla Public License, v. 2.0.
    Their source form: <code>builtin.abc</code> is built from the ActionScript in
    <code>core/</code> of <a href={avmplusSource}>swf2es's fork of avmplus at
    <code>{avmplusCommit}</code></a> (its <code>generated/builtin.abc</code>), and each
    translated file is linked below at this site's commit.
    <a href={licence("MPL-2.0.txt")}>Licence text</a>.
  </p>
  <details>
    <summary>{mpl.length} files under the MPL-2.0</summary>
    <ul>{mpl.map((f) => <li><a href={sourceUrl(f)}><code>{f}</code></a></li>)}</ul>
  </details>

  <h2>Ruffle</h2>
  <p>
    Much of swf2es's playerglobal (the <code>flash.*</code> classes, compiled into the player's
    scripts) and some of its natives are taken or ported from
    <a href="https://github.com/ruffle-rs/ruffle">Ruffle</a>, MIT OR Apache-2.0,
    Copyright (c) 2018-2022 Ruffle LLC and Ruffle contributors; each file says so.
    <a href={licence("ruffle-MIT.txt")}>MIT licence text</a>,
    <a href={licence("swf2es-Apache-2.0.txt")}>Apache License 2.0</a>.
  </p>
  <details>
    <summary>{ruffle.length} files from Ruffle</summary>
    <ul>{ruffle.map((f) => <li><a href={sourceUrl(f)}><code>{f}</code></a></li>)}</ul>
  </details>

  <h2>minimp3</h2>
  <p>
    <code>Sound.extract()</code> decodes MP3 frames synchronously with
    <a href="https://github.com/lieff/minimp3">minimp3</a>, compiled to WebAssembly.
    <a href={licence("minimp3-CC0.txt")}>CC0 licence text</a>.
  </p>

  <h2>libtess2</h2>
  <p>
    Vector fills use <a href="https://github.com/swf2es/libtess2">libtess2</a>,
    compiled to WebAssembly with double precision.
    <a href={licence("libtess2-SGI.txt")}>SGI Free Software License B licence text</a>.
  </p>

  <h2>zlib and the LZMA SDK</h2>
  <p>
    Compressed SWFs, bitmaps and <code>ByteArray</code>s are inflated and deflated by
    <a href="https://zlib.net/">zlib</a> (<a href={licence("zlib.txt")}>zlib licence text</a>),
    and <code>ByteArray</code>'s LZMA is written by the
    <a href="https://www.7-zip.org/sdk.html">LZMA SDK</a>'s encoder (public domain,
    <a href={licence("native-third-party.txt")}>notice</a>), both compiled to WebAssembly.
  </p>

  <h2>W3C</h2>
  <p>
    The turbulence of <code>BitmapData.perlinNoise</code> is derived from the
    <a href="https://www.w3.org/TR/SVG11/filters.html#feTurbulenceElement">SVG 1.1 specification</a>,
    Copyright © 2015 W3C® (MIT, ERCIM, Keio, Beihang), under the
    <a href="https://www.w3.org/copyright/software-license-2015/">W3C software license</a>.
  </p>

  <h2>Not here</h2>
  <p>
    Adobe's playerglobal is not part of this site: ActionScript 3 plays on swf2es's own.
    The demo SWFs are built from the repository's sources, Apache-2.0.
  </p>
</StarlightPage>
