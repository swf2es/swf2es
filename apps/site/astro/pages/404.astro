---
// The page GitHub Pages serves for a path the site does not have.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { base } from "../site.ts";

---

<StarlightPage
  frontmatter={{ title: "Not found", template: "splash", pagefind: false, tableOfContents: false }}
>
  <p>
    This page is not here. Try <a href={`${base}play/`}>the player</a>,
    <a href={`${base}docs/`}>the guide</a> or <a href={base}>the home page</a>.
  </p>
</StarlightPage>
