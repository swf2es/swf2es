---
// The home page: what swf2es is, and the way to the player, the guide and
// the compatibility page.
import { Card, CardGrid, LinkCard } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { base, guide } from "../site.ts";
---

<StarlightPage
  frontmatter={{
    title: "swf2es",
    description:
      "swf2es plays SWF files in the browser, their ActionScript compiled to JavaScript.",
    template: "splash",
    head: [
      // The player was the home page once: its shared links, ?swf=, go to it.
      {
        tag: "script",
        content:
          'if (new URLSearchParams(location.search).has("swf")) location.replace("play/" + location.search + location.hash);',
      },
    ],
    hero: {
      title: "SWF files in the browser",
      tagline:
        "swf2es compiles their ActionScript, AS3 and AS1/2 alike, to JavaScript, and draws them with a WebGL 2 renderer of its own. Open or drop a SWF: it is read in your browser, never uploaded.",
      image: { html: `<img src="${base}icon.svg" alt="" width="200" height="200">` },
      actions: [
        { text: "Play a SWF", link: `${base}play/`, icon: "right-arrow" },
        { text: "Read the guide", link: guide, variant: "minimal" },
      ],
    },
  }}
>
  <CardGrid>
    <Card title="ActionScript 3" icon="seti:javascript">
      Compiled to JavaScript as the SWF loads, so the browser's own JIT runs it, and checked
      against avmshell on Tamarin's acceptance tests.
    </Card>
    <Card title="ActionScript 1 and 2" icon="document">
      AVM1's timelines, clips, buttons, text fields and loads, compiled to JavaScript as well.
    </Card>
    <Card title="The player" icon="puzzle">
      The display list and timeline, shapes, morphs, text, bitmaps, filters, blend modes, sound,
      input, sockets, workers and ExternalInterface, each checked against Flash. Stage3D is an
      experimental opt-in.
    </Card>
    <Card title="Not yet" icon="warning">
      <p>
        Video and printing. Compatibility is incomplete: some SWFs draw or behave differently.
      </p>
      <a class="card-more" href={`${base}compatibility/`}>See compatibility →</a>
    </Card>
  </CardGrid>

  <h2>Try a demo</h2>
  <CardGrid>
    <LinkCard
      title="Bounce (ActionScript 3)"
      description="Gradients, glow filters and additive blending."
      href={`${base}play/?swf=demos%2Fbounce.swf`}
    />
    <LinkCard
      title="Orbit (ActionScript 1 and 2)"
      description="A SWF 8 timeline whose frame actions trace."
      href={`${base}play/?swf=demos%2Forbit.swf`}
    />
  </CardGrid>

  <h2>Use it</h2>
  <CardGrid>
    <LinkCard
      title="Embed a SWF in a page"
      description="The <swf2es-player> element, and replacing a page's Flash tags."
      href={guide}
    />
    <LinkCard
      title="Compatibility"
      description="How much of ActionScript and Flash Player runs as Flash does, from swf2es's own tests."
      href={`${base}compatibility/`}
    />
    <LinkCard
      title="How it works"
      description="The compiler, runtime and player, in the repository's architecture notes."
      href="https://github.com/swf2es/swf2es/blob/main/docs/architecture.md"
    />
  </CardGrid>
</StarlightPage>

<style>
  /* A card's link sits at its bottom, however tall its row. */
  :global(.card:has(.card-more)) :global(.body) {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-more {
    margin-top: auto;
    padding-top: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .card-more:hover {
    text-decoration: underline;
  }
</style>
