---
// The player: the page's <swf2es-player> and what a person trying a SWF wants
// around it, run by src/main.ts (bundled by bundle.ts into app/), which
// imports the element from the browser build in player/. Its ids are what
// main.ts and tests/site/run.ts look for.

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { base, facts } from "../site.ts";
import "../styles/player.css";

const { build } = facts;

/**
 * Until the page's script says it is running, a failure to fetch or run it,
 * or the browser build it imports, says so in place of "Loading player…",
 * which would otherwise stay. A classic script, ahead of the module, so it
 * hears both: a module or its imports that fail to load fire error at its
 * script element, which the window hears only as it captures; one that
 * throws as it runs, the window's error event.
 */
const failure = `(() => {
  const root = new URL(${JSON.stringify(base)}, location.href);
  // The page's script, the browser build and its chunks, on this site; not, say, an extension's.
  const ours = (url) => {
    if (typeof url !== "string" || url === "") return false;
    const { origin, pathname } = new URL(url, location.href);
    if (origin !== root.origin || !pathname.startsWith(root.pathname)) return false;
    return /^(app|player|player\\/chunks)\\/[^/]+$/.test(pathname.slice(root.pathname.length));
  };
  addEventListener("error", (e) => {
    if (globalThis.swf2esPlayerReady) return;
    const script = e.target instanceof HTMLScriptElement && ours(e.target.src);
    if (!script && !(e instanceof ErrorEvent && ours(e.filename))) return;
    const label = document.getElementById("loading-label");
    const progress = document.getElementById("loading-progress");
    const status = document.getElementById("status");
    if (!label || !progress || !status) return;
    const message = "The player did not load. Reload the page to try again.";
    label.textContent = message;
    progress.hidden = true;
    status.textContent = message;
    status.classList.add("error");
  }, true);
})();`;
---

<StarlightPage
  frontmatter={{
    title: "Play a SWF",
    description:
      "Play SWF files in your browser with swf2es, which compiles their ActionScript to JavaScript. Files you open stay on your device.",
    template: "splash",
    tableOfContents: false,
    head: [
      { tag: "script", content: failure },
      // Without JavaScript, the status line below gives way to one that says so.
      { tag: "noscript", content: "<style>#status { display: none; }</style>" },
      // Fetched beside the page's script rather than once it has arrived and named it.
      { tag: "link", attrs: { rel: "modulepreload", href: `${base}player/swf2es.js` } },
      { tag: "script", attrs: { type: "module", src: `${base}app/main.js` } },
    ],
  }}
>
<div class="not-content player-app" data-build={build}>
    <section class="open" aria-label="Open a SWF">
      <input id="file" type="file" accept=".swf,.air,.zip,application/x-shockwave-flash" class="visually-hidden">
      <label class="button primary" for="file">Open a SWF…</label>
      <form id="url-form" class="url">
        <label class="visually-hidden" for="url">SWF URL</label>
        <input id="url" type="url" placeholder="https://example.com/movie.swf" inputmode="url" autocomplete="url">
        <button type="submit">Load URL</button>
      </form>
    </section>
    <p class="note">
      Files you open or drop are read in this browser: <strong>nothing is uploaded</strong>.
      A URL loads only where its server allows other sites to load it (CORS).
    </p>

    <div id="stage" class="stage">
      <div id="empty" class="empty" hidden>
        <p><strong>Drop a SWF here</strong>, open one, or try a demo below.</p>
      </div>
      <div id="ask" class="empty ask" hidden>
        <div>
          <p>Play <strong id="ask-file"></strong>?</p>
          <p class="warning">This SWF comes from <strong id="ask-host"></strong>; it can draw
            anything, including fake login forms. Only play SWFs you trust.</p>
          <button id="ask-play" class="primary" type="button">Play</button>
        </div>
      </div>
      <swf2es-player id="player" width="100%" height="100%" scale="showAll" allowscriptaccess="never" hidden></swf2es-player>
      <!-- Over the player until its first frame: the player's code, then a SWF's download and start. -->
      <div id="loading" class="empty loading">
        <div>
          <p id="loading-label">Loading player…</p>
          <progress id="loading-progress" max="1" aria-labelledby="loading-label"></progress>
        </div>
      </div>
      <noscript>
        <div class="empty loading"><p>The player needs JavaScript, which this browser has turned off.</p></div>
      </noscript>
    </div>

    <p id="status" class="status" role="status" aria-live="polite">Loading player…</p>
    <noscript><p class="status error">The player needs JavaScript, which this browser has turned off.</p></noscript>

    <section class="controls" aria-label="Player controls">
      <label title="How smoothly edges and bitmaps are drawn: Low is the fastest, Best the smoothest">Quality
        <select id="quality">
          <option value="low">Low</option>
          <option value="medium">Medium</option>
          <option value="high" selected>High</option>
          <option value="best">Best</option>
        </select>
      </label>
      <label title="How the SWF fits the player">Scale
        <select id="scale">
          <option value="showAll" selected>Show all</option>
          <option value="noBorder">No border</option>
          <option value="exactFit">Exact fit</option>
          <option value="noScale">No scale</option>
        </select>
      </label>
      <label title="Turns Stage3D (GPU 3D for SWFs that use it) on or off, restarting the SWF"><input id="stage3d" type="checkbox"> Stage3D</label>
      <button id="reload" type="button" title="Plays the SWF again from the start" disabled>Restart</button>
      <button id="close" type="button" title="Stops and closes the SWF" disabled>Close</button>
      <button id="fullscreen" type="button" title="Fills the screen with the player">Full screen</button>
      <button id="meter-toggle" class="toggle" type="button" aria-pressed="false" aria-keyshortcuts="Control+Shift+F" title="Shows or hides the performance meter (fps, frame time, memory). Ctrl+Shift+F shows it, moves it through the corners, then hides it">Show stats</button>
    </section>

    <div class="panels">
      <section class="panel console" aria-labelledby="console-title">
        <div class="panel-head">
          <h2 id="console-title">Console</h2>
          <label class="trace-toggle" title="Shows the SWF's trace() output in the console"><input id="trace-logging" type="checkbox" checked> Trace logging</label>
          <button id="copy-log" type="button" title="Copies the console's text to the clipboard">Copy</button>
          <button id="clear-log" type="button" title="Empties the console">Clear</button>
          <a id="report" class="button" href="https://github.com/swf2es/swf2es/issues/new" target="_blank" rel="noopener" title="Opens a GitHub issue filled in with the build, browser, settings, SWF details and errors; local file names are left out">Report a problem</a>
        </div>
        <div id="log" class="log" role="log" aria-live="off"></div>
      </section>

      <section class="panel" aria-labelledby="facts-title">
        <h2 id="facts-title">This SWF</h2>
        <dl id="facts" class="facts"><dt>File</dt><dd>none yet</dd></dl>
      </section>
    </div>

    <section class="panel" aria-labelledby="demos-title">
      <h2 id="demos-title">Demos</h2>
      <p>Built from the swf2es repository's own sources at this site's build.</p>
      <ul id="demos" class="demos"></ul>
    </section>

    <section class="panel about" aria-labelledby="about-title">
      <h2 id="about-title">What to expect</h2>
      <ul>
        <li><strong>ActionScript 3</strong> (AVM2) runs, compiled to JavaScript as the SWF loads. A camera plays in a Video; video streams (NetStream) are not implemented.</li>
        <li><strong>Stage3D is off until you tick it.</strong> Tick Stage3D in the player controls before opening a Stage3D SWF; changing it restarts the current SWF. It needs WebGL 2.</li>
        <li><strong>ActionScript 1 and 2</strong> (AVM1) run too, compiled to JavaScript, including clips and their events, buttons, mouse and keyboard input, drawing, editable text fields and CSS, sound, filters and blend modes, <code>BitmapData</code>, <code>SharedObject</code>, and loading with <code>loadMovie</code>, <code>MovieClipLoader</code>, <code>LoadVars</code> and <code>XML</code>. File dialogs and transfers through <code>FileReference</code>, browser scripting through <code>ExternalInterface</code>, HTTP remoting through <code>NetConnection</code>, and <code>LocalConnection</code> messaging between SWFs within one player (including AVM1 and AVM2) are supported. Compatibility is still incomplete: video streams and printing are not implemented, and some SWFs have rendering or interaction differences.</li>
        <li><strong>No sockets.</strong> A browser cannot open TCP connections and this static site runs no relay, so <code>Socket</code> and <code>XMLSocket</code> fail as refused.</li>
        <li><strong>Cross-origin loads.</strong> A SWF by URL, and whatever it loads from another site, arrive only where that server allows it (CORS headers).</li>
        <li><strong>Files you open</strong> play as if from this site's <code>local/</code> folder, by their names: what one loads by a relative URL is not there, and each name keeps its own saved data (SharedObjects) in this browser.</li>
        <li>The page keeps the code it compiled in this browser's IndexedDB, so a SWF starts faster next time.</li>
        <li>ActionScript 3 links against avmplus' <code>builtin.abc</code> (MPL-2.0) and swf2es's own playerglobal, never Adobe's. See the <a href={`${base}notices/`}>licences</a>.</li>
      </ul>
      <p class="build">Build <code>{build}</code></p>
    </section>
</div>
</StarlightPage>
