---
// The player: the page's <swf2es-player> and what a person trying a SWF wants
// around it, run by src/main.ts (dist/js/, staged in app/). Its ids are what
// main.ts and tests/site/run.ts look for.

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { base, facts } from "../site.ts";
import "../styles/player.css";

const { build, importMap } = facts;
---

<StarlightPage
  frontmatter={{
    title: "Play a SWF",
    description:
      "Play SWF files in your browser with swf2es, which compiles their ActionScript to JavaScript. Files you open stay on your device.",
    template: "splash",
    tableOfContents: false,
    head: [
      // Before any module script: the player's bare imports resolve through it.
      { tag: "script", attrs: { type: "importmap" }, content: JSON.stringify(importMap) },
      { tag: "script", attrs: { type: "module", src: `${base}app/main.js` } },
    ],
  }}
>
<div class="not-content player-app" data-build={build}>
    <section class="open" aria-label="Open a SWF">
      <input id="file" type="file" class="visually-hidden">
      <label class="button primary" for="file">Open a SWF…</label>
      <form id="url-form" class="url">
        <label class="visually-hidden" for="url">SWF URL</label>
        <input id="url" type="url" placeholder="https://example.com/movie.swf" inputmode="url" autocomplete="url">
        <button type="submit">Load URL</button>
      </form>
    </section>
    <p class="note">
      Files you open or drop are read in this browser: <strong>nothing is uploaded</strong>.
      A URL loads only where its server allows other sites to load it (CORS).
    </p>

    <div id="stage" class="stage">
      <div id="empty" class="empty">
        <p><strong>Drop a SWF here</strong>, open one, or try a demo below.</p>
      </div>
      <div id="ask" class="empty ask" hidden>
        <div>
          <p>Play <strong id="ask-file"></strong>?</p>
          <p class="warning">This SWF comes from <strong id="ask-host"></strong>; it can draw
            anything, including fake login forms. Only play SWFs you trust.</p>
          <button id="ask-play" class="primary" type="button">Play</button>
        </div>
      </div>
      <swf2es-player id="player" width="100%" height="100%" scale="showAll" allowscriptaccess="never" hidden></swf2es-player>
    </div>

    <p id="status" class="status" role="status" aria-live="polite"></p>

    <section class="controls" aria-label="Player controls">
      <label>Quality
        <select id="quality">
          <option value="low">Low</option>
          <option value="medium">Medium</option>
          <option value="high" selected>High</option>
          <option value="best">Best</option>
        </select>
      </label>
      <label>Scale
        <select id="scale">
          <option value="showAll" selected>Show all</option>
          <option value="noBorder">No border</option>
          <option value="exactFit">Exact fit</option>
          <option value="noScale">No scale</option>
        </select>
      </label>
      <label><input id="stage3d" type="checkbox"> Stage3D (experimental)</label>
      <button id="reload" type="button" disabled>Restart</button>
      <button id="close" type="button" disabled>Close</button>
      <button id="fullscreen" type="button">Full screen</button>
      <dl class="stats" aria-label="Performance">
        <div><dt>fps</dt><dd id="fps">–</dd></div>
        <div><dt>frame</dt><dd id="frame-time">–</dd></div>
        <div><dt>sub-draws</dt><dd id="sub-draws">–</dd></div>
        <div><dt>GL calls</dt><dd id="gl-calls">–</dd></div>
        <div><dt>heap</dt><dd id="heap">–</dd></div>
      </dl>
    </section>

    <div class="panels">
      <section class="panel console" aria-labelledby="console-title">
        <div class="panel-head">
          <h2 id="console-title">Console</h2>
          <label class="trace-toggle"><input id="trace-logging" type="checkbox" checked> Trace logging</label>
          <button id="copy-log" type="button">Copy</button>
          <button id="clear-log" type="button">Clear</button>
          <a id="report" class="button" href="https://github.com/swf2es/swf2es/issues/new" target="_blank" rel="noopener">Report a problem</a>
        </div>
        <div id="log" class="log" role="log" aria-live="off"></div>
      </section>

      <section class="panel" aria-labelledby="facts-title">
        <h2 id="facts-title">This SWF</h2>
        <dl id="facts" class="facts"><dt>File</dt><dd>none yet</dd></dl>
      </section>
    </div>

    <section class="panel" aria-labelledby="demos-title">
      <h2 id="demos-title">Demos</h2>
      <p>Built from the swf2es repository's own sources at this site's build.</p>
      <ul id="demos" class="demos"></ul>
    </section>

    <section class="panel about" aria-labelledby="about-title">
      <h2 id="about-title">What to expect</h2>
      <ul>
        <li><strong>ActionScript 3</strong> (AVM2) runs, compiled to JavaScript as the SWF loads. Video is not implemented.</li>
        <li><strong>Stage3D is experimental.</strong> Enable it in the player controls before opening a Stage3D SWF. Changing the option restarts the current SWF. It requires WebGL 2; compatibility is still incomplete.</li>
        <li><strong>ActionScript 1 and 2</strong> (AVM1) run too, compiled to JavaScript, including clips and their events, buttons, mouse and keyboard input, drawing, editable text fields and CSS, sound, filters and blend modes, <code>BitmapData</code>, <code>SharedObject</code>, and loading with <code>loadMovie</code>, <code>MovieClipLoader</code>, <code>LoadVars</code> and <code>XML</code>. File dialogs and transfers through <code>FileReference</code>, browser scripting through <code>ExternalInterface</code>, HTTP remoting through <code>NetConnection</code>, and <code>LocalConnection</code> messaging between SWFs within one player (including AVM1 and AVM2) are supported. Compatibility is still incomplete: video and printing are not implemented, and some SWFs have rendering or interaction differences.</li>
        <li><strong>No sockets.</strong> A browser cannot open TCP connections and this static site runs no relay, so <code>Socket</code> and <code>XMLSocket</code> fail as refused.</li>
        <li><strong>Cross-origin loads.</strong> A SWF by URL, and whatever it loads from another site, arrive only where that server allows it (CORS headers).</li>
        <li><strong>Files you open</strong> play as if from this site's <code>local/</code> folder, by their names: what one loads by a relative URL is not there, and each name keeps its own saved data (SharedObjects) in this browser.</li>
        <li>The page keeps the code it compiled in this browser's IndexedDB, so a SWF starts faster next time.</li>
        <li>ActionScript 3 links against avmplus' <code>builtin.abc</code> (MPL-2.0) and swf2es's own playerglobal, never Adobe's. See the <a href={`${base}notices/`}>licences</a>.</li>
      </ul>
      <p class="build">Build <code>{build}</code></p>
    </section>
</div>
</StarlightPage>
