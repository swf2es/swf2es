{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../dist/launch",
    "tsBuildInfoFile": "../../dist/launch/.tsbuildinfo",
    "types": ["node"],
    // Its modules import each other by their .ts names, so that node runs
    // them as they are in the tests, and the build writes .js.
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2022"]
  },
  "include": ["*.ts"]
}
