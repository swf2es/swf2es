{
  "name": "swf2es-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter @swf2es/codegen build:wasm && tsc -b packages/*",
    "clean": "tsc -b --clean packages/*",
    "test": "pnpm -r --filter './tests/*' test",
    "oracle:avmshell": "node oracle/avmshell/fetch.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*",
    "tests/*"
  ]
}
