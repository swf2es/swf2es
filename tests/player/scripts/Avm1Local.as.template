// An AS3 SWF talking to two AVM1 SWFs it loads (tests/player/cases/avm1.ts,
// avm1Local) by LocalConnection, both ways: values of each kind, names
// with and without an underscore, with the domain or another before them
// and in other cases, a method the movie lacks, a movie answering, one movie calling the
// other, and a movie unloaded. A step every third frame, so that a step's
// messages arrive and its traces are printed before the next begins.
package
{
	import flash.display.Loader;
	import flash.display.MovieClip;
	import flash.events.AsyncErrorEvent;
	import flash.events.Event;
	import flash.events.StatusEvent;
	import flash.net.LocalConnection;
	import flash.system.ApplicationDomain;
	import flash.system.LoaderContext;
	import flash.system.System;
	import flash.utils.ByteArray;
	import flash.utils.getQualifiedClassName;

	public class Main extends MovieClip
	{
		private static const A:String = "@@A@@";
		private static const B:String = "@@B@@";
		private var a:Loader;
		private var b:Loader;
		private var receiver:LocalConnection = new LocalConnection();
		private var plain:LocalConnection = new LocalConnection();
		private var sender:LocalConnection = new LocalConnection();
		private var frame:int = 0;
		private var steps:Array;

		public function Main()
		{
			receiver.client = {take: take("host"), value: 5, bad: function():void
				{
					trace("host bad");
					throw new Error("thrown");
				}};
			plain.client = {take: take("hostPlain")};
			receiver.addEventListener(AsyncErrorEvent.ASYNC_ERROR, function(e:AsyncErrorEvent):void
				{
					trace("host async " + e.error);
				});
			sender.addEventListener(StatusEvent.STATUS, function(e:StatusEvent):void
				{
					trace("host status " + e.level + " " + e.code);
				});
			trace("host connect " + connect(receiver, "_host") + " " + connect(plain, "hostPlain"));
			trace("host domain " + local(receiver.domain));
			a = load(A);
			b = load(B);
			steps = [primitives, objects, names, missing, replies, between, closed, unloaded, later, collected];
			addEventListener(Event.ENTER_FRAME, step);
		}

		private function step(e:Event):void
		{
			if (++frame % 3 != 0)
			{
				return;
			}

			if (steps.length == 0)
			{
				removeEventListener(Event.ENTER_FRAME, step);
				trace("done");
				return;
			}

			var next:Function = steps.shift();
			next();
		}

		private function primitives():void
		{
			trace("-- primitives");
			send("_childA", "take", 1, 1.5, -3, "s", "", true, false, null, undefined, NaN, Infinity);
		}

		private function objects():void
		{
			trace("-- objects");
			var list:Array = [1, "two", [3]];
			list.label = "named";
			send("_childA", "take", {a: 1, nested: {b: [1, 2], s: "x"}}, list, new Date(123000), []);
		}

		private function names():void
		{
			trace("-- names");
			send("childAPlain", "take", 1);
			send(receiver.domain + ":childAPlain", "take", 2);
			send(receiver.domain.toUpperCase() + ":CHILDAPLAIN", "take", 3);
			send("otherhost:childAPlain", "take", 4);
			send("_CHILDA", "take", 5);
			send(receiver.domain + ":_childA", "take", 6);
		}

		private function missing():void
		{
			trace("-- missing");
			send("_childA", "missing", 1);
			send("_childA", "bad");
			send("_childA", "value");
			send("_nowhere", "take", 1);
			send("_host", "missing", 1);
			send("_host", "value", 1);
			send("_host", "bad");
		}

		private function replies():void
		{
			trace("-- replies");
			send("_childA", "reply");
		}

		private function between():void
		{
			trace("-- between");
			send("_childA", "toB");
		}

		private function closed():void
		{
			trace("-- closed");
			send("_childB", "shut");
		}

		private function unloaded():void
		{
			trace("-- unloaded");
			send("_childB", "take", "after close");
			a.unloadAndStop();
			send("_childA", "take", "after unload");
		}

		private function later():void
		{
			trace("-- later");
			send("_childA", "take", "later");
			send("_childA", "reply");
			trace("host takes _childA " + connect(new LocalConnection(), "_childA"));
			removeChild(a);
			a = null;
			System.gc();
		}

		private function collected():void
		{
			trace("-- collected");
			send("_childA", "take", "collected");
		}

		/** The domain, the same however the SWF is played: adl's is its AIR application's, a page's from disk localhost. */
		private static function local(domain:String):String
		{
			return domain == "localhost" || domain.indexOf("app#") == 0 ? "local" : domain;
		}

		private function send(name:String, method:String, ... args):void
		{
			try
			{
				sender.send.apply(sender, [name, method].concat(args));
				trace("host send " + name.replace(receiver.domain, "<domain>").replace(receiver.domain.toUpperCase(), "<DOMAIN>") + " " + method);
			}
			catch (e:Error)
			{
				trace("host send " + name + " " + method + " " + e);
			}
		}

		private function connect(lc:LocalConnection, name:String):String
		{
			try
			{
				lc.connect(name);
				return "ok";
			}
			catch (e:Error)
			{
				return String(e);
			}
		}

		private function take(who:String):Function
		{
			return function(... args):void
			{
				trace(who + " take " + args.length + " " + show(args));
			};
		}

		private function load(bytes:String):Loader
		{
			var loader:Loader = new Loader();
			addChild(loader);
			// AIR, where Flash is run, refuses to load code from bytes unless asked to.
			var context:LoaderContext = new LoaderContext(false, ApplicationDomain.currentDomain);
			context.allowCodeImport = true;
			loader.loadBytes(decode(bytes), context);
			return loader;
		}

		private static function show(v:*):String
		{
			if (v === undefined)
			{
				return "undefined";
			}

			if (v === null)
			{
				return "null";
			}

			if (v is String)
			{
				return "'" + v + "'";
			}

			if (v is Date)
			{
				return "Date(" + v.getTime() + ")";
			}

			if (v is Array)
			{
				var items:Array = [];
				for (var i:int = 0; i < v.length; i++)
				{
					items.push(show(v[i]));
				}

				var extra:Array = [];
				for (var k:String in v)
				{
					if (String(int(k)) != k)
					{
						extra.push(k + "=" + show(v[k]));
					}
				}

				return "[" + items.join(",") + (extra.length ? ";" + extra.sort().join(",") : "") + "]";
			}

			if (getQualifiedClassName(v) == "Object")
			{
				var keys:Array = [];
				for (var key:String in v)
				{
					keys.push(key);
				}

				keys.sort();
				var fields:Array = [];
				for each (var name:String in keys)
				{
					fields.push(name + "=" + show(v[name]));
				}

				return "{" + fields.join(",") + "}";
			}

			return getQualifiedClassName(v) + ":" + v;
		}

		/** Base64, as the bytes are carried in this script. */
		private static function decode(text:String):ByteArray
		{
			const ALPHABET:String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
			var out:ByteArray = new ByteArray();
			var bits:int = 0;
			var have:int = 0;
			for (var i:int = 0; i < text.length; i++)
			{
				var c:String = text.charAt(i);
				if (c == "=")
				{
					break;
				}

				bits = ((bits << 6) | ALPHABET.indexOf(c)) & 0xffff;
				have += 6;
				if (have >= 8)
				{
					have -= 8;
					out.writeByte((bits >> have) & 0xff);
				}
			}

			out.position = 0;
			return out;
		}
	}
}
