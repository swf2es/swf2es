// Array in AVM1, by version (docs/avm1.md, "Array and String"): the
// methods, holes and length, what watchers see of the methods' writes,
// sort's and sortOn's options, comparators and order, and for..in's order
// after them. The comparator's calls are traced, which shows Flash's quicksort.
function show(label, a) { trace(label + ": [" + a.join("|") + "] len=" + a.length); }
function keys(o) { var s = ""; for (var k in o) { s += k + " "; } return s; }
function watchAll(a, n) {
  for (var i = 0; i < n; i++) {
    a.watch(String(i), function (k, o, v) { trace("  w" + k + " " + o + " -> " + v); return v; });
  }
  a.watch("length", function (k, o, v) { trace("  len " + o + " -> " + v); return v; });
}

// -- methods
var a = [1, 2, 3];
trace("push " + a.push(4, 5));
show("a", a);
trace("pop " + a.pop());
trace("shift " + a.shift());
trace("unshift " + a.unshift("x", "y"));
show("a", a);
trace("reverse " + (a.reverse() == a));
show("a", a);
var e = [];
trace("pop empty " + e.pop());
trace("shift empty " + e.shift());
trace("push none " + e.push());
trace("unshift none " + e.unshift());
show("e", e);
// slice
var s = [0, 1, 2, 3, 4];
show("slice()", s.slice());
show("slice(1)", s.slice(1));
show("slice(1,3)", s.slice(1, 3));
show("slice(-2)", s.slice(-2));
show("slice(-2,-1)", s.slice(-2, -1));
show("slice(3,1)", s.slice(3, 1));
show("slice(undefined,2)", s.slice(undefined, 2));
show("slice(1,undefined)", s.slice(1, undefined));
show("slice('1','3')", s.slice("1", "3"));
show("slice(1.7,3.9)", s.slice(1.7, 3.9));
show("slice(-100)", s.slice(-100));
show("slice(100)", s.slice(100));
show("slice(NaN)", s.slice(0/0));
show("slice(0,null)", s.slice(0, null));
// splice
var p = [0, 1, 2, 3, 4];
show("splice(1,2)", p.splice(1, 2)); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(1,0,a,b)", p.splice(1, 0, "a", "b")); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(1,1,a,b,c)", p.splice(1, 1, "a", "b", "c")); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(-2)", p.splice(-2)); show("p", p);
p = [0, 1, 2, 3, 4];
trace("splice() " + p.splice()); show("p", p);
p = [0, 1, 2, 3, 4];
trace("splice(undefined) " + p.splice(undefined)); show("p", p);
p = [0, 1, 2, 3, 4];
trace("splice(1,undefined) " + p.splice(1, undefined)); show("p", p);
p = [0, 1, 2, 3, 4];
trace("splice(1,-1) " + p.splice(1, -1)); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(1,100)", p.splice(1, 100)); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(10,1,z)", p.splice(10, 1, "z")); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice(1,null)", p.splice(1, null)); show("p", p);
p = [0, 1, 2, 3, 4];
show("splice('1','2')", p.splice("1", "2")); show("p", p);
// concat
var c = [1, 2];
show("concat()", c.concat());
show("concat(3,[4,5],[[6]])", c.concat(3, [4, 5], [[6, 7]]));
trace("concat len " + c.concat([8], 9).length);
show("concat(obj)", c.concat({length: 2, 0: "a"}));
show("concat str", c.concat("ab"));
// join
trace("join() " + c.join());
trace("join(undefined) " + c.join(undefined));
trace("join(null) " + c.join(null));
trace("join('') " + c.join(""));
trace("join(1) " + c.join(1));
var u = [undefined, null, true, 1.5, "s", {}, [1, [2, 3]]];
trace("join mixed " + u.join());
trace("toString " + u.toString());
trace("String " + String(u));
trace("empty join [" + [].join() + "]");

// -- holes, length, getters and attributes
var h = [];
h[3] = "d";
show("hole", h);
trace("keys " + keys(h));
trace("has0 " + h.hasOwnProperty(0) + " has3 " + h.hasOwnProperty(3));
h.push("e");
trace("keys " + keys(h));
var r = h.reverse();
show("rev", h);
trace("keys rev " + keys(h));
trace("has0 " + h.hasOwnProperty(0) + " has1 " + h.hasOwnProperty(1) + " has4 " + h.hasOwnProperty(4));
var sp = [0, 1, 2, 3];
delete sp[1];
show("del", sp);
sp.splice(0, 1);
show("splice del", sp);
trace("keys " + keys(sp));
var un = [0, 1, 2];
delete un[1];
un.unshift("u");
trace("keys un " + keys(un));
var sh = [0, 1, 2];
delete sh[1];
sh.shift();
trace("keys sh " + keys(sh) + " len " + sh.length);
var po = [0, 1, 2];
delete po[2];
trace("pop hole " + po.pop() + " len " + po.length);
// length
var l = [0, 1, 2, 3];
l.length = 2;
show("len2", l);
trace("keys " + keys(l));
l.length = 4;
show("len4", l);
trace("keys " + keys(l));
l.length = "3";
trace("len str " + l.length + " " + typeof l.length);
l.length = -1;
trace("len -1 " + l.length + " keys " + keys(l));
l = [0, 1];
l.length = 1.9;
trace("len 1.9 " + l.length);
l.length = 0/0;
trace("len NaN " + l.length);
var big = new Array(5);
trace("new Array(5) " + big.length + " keys " + keys(big) + " [" + big + "]");
big = new Array("5");
trace("new Array('5') " + big.length + " " + big);
big = new Array(2.5);
trace("new Array(2.5) " + big.length);
big = new Array(-1);
trace("new Array(-1) " + big.length);
big = Array(3);
trace("Array(3) " + big.length);
big = Array(1, 2);
trace("Array(1,2) " + big);
big = new Array();
trace("new Array() " + big.length);
// prototype elements
Array.prototype[0] = "P";
var pa = new Array(2);
show("proto elems", pa);
trace("pa[0] " + pa[0]);
delete Array.prototype[0];
// getters on elements
var g = [1, 2, 3];
g.addProperty("1", function () { return "G"; }, function (v) { trace("set " + v); });
show("getter", g);
trace("g[1] " + g[1]);
g.reverse();
show("getter rev", g);
trace("g[1] after " + g[1]);
var g2 = [1, 2, 3];
g2.watch("0", function (n, o, v) { trace("watch " + n + " " + o + " " + v); return v; });
g2.push(4);
g2.reverse();
show("watched rev", g2);
g2.unshift(9);
g2.shift();
// readonly element
var ro = [1, 2, 3];
ASSetPropFlags(ro, "0", 4);
ro[0] = "no";
trace("ro[0] " + ro[0]);
ro.reverse();
show("ro rev", ro);
var dd = [1, 2, 3];
ASSetPropFlags(dd, "2", 2);
dd.pop();
show("dontdelete pop", dd);
trace("keys dd " + keys(dd));

// -- watchers
var w = [1, 2, 3];
w.watch("0", function (n, o, v) { trace("w0 " + n + " " + o + " " + v); return v; });
trace("set 5"); w[5] = 7;
trace("push"); w.push(8);
trace("set 0"); w[0] = 11;
trace("delete 0"); delete w[0];
trace("set 0 again"); w[0] = 12;
trace("pop"); w.pop();
trace("splice"); w.splice(1, 1, "s");
trace("sort"); w.sort();
trace("length"); w.length = 2;
trace("w " + w);
var x = [1, 2, 3];
x.watch("2", function (n, o, v) { trace("x2 " + n + " " + o + " " + v); return "W" + v; });
trace("push x"); x.push(4);
trace("x " + x);
trace("rev x"); x.reverse();
trace("x " + x);
