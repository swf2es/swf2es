trace("rev z"); Array.prototype.reverse.call(z);
trace("z " + z[0] + z[1] + z[2] + " " + z.length);
var a = [0, 1, 2, 3, 4]; watchAll(a, 8);
trace("splice(1,1,s)"); a.splice(1, 1, "s");
a = [0, 1, 2, 3, 4]; watchAll(a, 8);
trace("splice(1,2)"); a.splice(1, 2);
a = [0, 1, 2, 3, 4]; watchAll(a, 8);
