// -- sortOn, and arrays among other values
function showRecs(label, a) { var s = ""; for (var i = 0; i < a.length; i++) { var e = a[i]; s += (typeof e == "object" && e != null ? "{" + e.n + "," + e.v + "}" : e) + " "; } trace(label + ": " + s); }
function rec(n, v) { var o = {}; o.n = n; o.v = v; return o; }
var d = [rec("b", 2), rec("a", 10), rec("C", 1), rec("a", 9)];
showRecs("sortOn n", d.sortOn("n"));
showRecs("sortOn v", d.sortOn("v"));
showRecs("sortOn v 16", d.sortOn("v", 16));
showRecs("sortOn v 18", d.sortOn("v", 18));
showRecs("sortOn n 1", d.sortOn("n", 1));
showRecs("sortOn [n,v]", d.sortOn(["n", "v"]));
showRecs("sortOn [n,v] [0,16]", d.sortOn(["n", "v"], [0, 16]));
showRecs("sortOn [n,v] [2,18]", d.sortOn(["n", "v"], [2, 18]));
showRecs("sortOn [n,v] 2", d.sortOn(["n", "v"], 2));
trace("sortOn n 8 " + d.sortOn("n", 8));
trace("sortOn n 4 " + d.sortOn("n", 4));
trace("sortOn v 4 " + d.sortOn("v", 4));
trace("sortOn () " + d.sortOn());
trace("sortOn [] " + (d.sortOn([]) == d));
showRecs("sortOn missing", d.sortOn("zz"));
showRecs("sortOn obj", d.sortOn({}));
var m = [3, rec("a", 1), "x", rec("b", 0)];
showRecs("sortOn mixed", m.sortOn("v"));
var p = [rec("b", 1), rec("a", 2)];
p[0].__proto__ = {k: "z"}; p[1].k = "y";
showRecs("sortOn inherited", p.sortOn("k"));
var q = [rec("B", 1), rec("a", 2)];
showRecs("sortOn N case", q.sortOn("N"));
trace("CASEINSENSITIVE " + Array.CASEINSENSITIVE + " DESCENDING " + Array.DESCENDING + " UNIQUESORT " + Array.UNIQUESORT + " RETURNINDEXEDARRAY " + Array.RETURNINDEXEDARRAY + " NUMERIC " + Array.NUMERIC);
var hs = [1]; hs[3] = 4;
trace("slice holes " + hs.slice(0).length + " keys ");
var sl = hs.slice(0); var ks = ""; for (var k in sl) ks += k + " "; trace("slice keys " + ks);
var cc = hs.concat([5]); ks = ""; for (var k in cc) ks += k + " "; trace("concat keys " + ks + cc.length);
var nested = [1, [2, [3, [4]]], "x"];
trace("nested " + nested + " " + nested.length);
var al = {length: 3, 0: "a", 2: "c"};
trace("join arraylike " + Array.prototype.join.call(al, "-"));
trace("slice arraylike " + Array.prototype.slice.call(al, 0).length);
trace("concat arraylike " + Array.prototype.concat.call(al, 1).length);
trace("toString arraylike " + Array.prototype.toString.call(al));
var x = [1, 2];
x.foo = "bar";
ks = ""; for (var k in x) ks += k + " "; trace("keys foo " + ks);
x.push(3);
ks = ""; for (var k in x) ks += k + " "; trace("keys foo push " + ks);
x.reverse();
ks = ""; for (var k in x) ks += k + " "; trace("keys foo rev " + ks);
var y = [1, 2, 3];
y.sort(16 | 2);
ks = ""; for (var k in y) ks += k + " "; trace("keys sorted " + ks);
var cy = [1, 2]; cy[0] = cy;
trace("self len " + cy.length);
trace("typeof " + typeof []);
trace("constructor " + ([].constructor == Array));
trace("arr == arr " + ([1] == [1]));
trace("arr + 1 " + ([1, 2] + 1));
trace("arr num " + ([5] * 2));
trace("arr less " + ([2] < [10]));

// -- elements by number, as loops read and write them
var n = [10, 20, 30];
trace("n[1] " + n[1] + " n[1.5] " + n[1.5] + " n[-1] " + n[-1] + " n['01'] " + n["01"] + " n[3] " + n[3]);
n[1] = 21; n[3] = 40; n[1.5] = "half"; n["01"] = "zero-one";
trace("n " + n + " len " + n.length + " keys " + keys(n));
var sum = 0;
for (var i = 0; i < n.length; i++) { sum += n[i]; }
trace("sum " + sum);
var built = [];
for (var i = 0; i < 5; i++) { built[i] = i * i; }
trace("built " + built + " len " + built.length + " keys " + keys(built));
built[7] = 49;
trace("built " + built + " len " + built.length + " keys " + keys(built));
delete built[0];
trace("keys after delete " + keys(built));
var args = (function () { return arguments; })(1, 2, 3);
trace("arguments " + args.length + " " + args.join("+") + " " + args.reverse());
