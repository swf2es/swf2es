a = [0, 1, 2, 3, 4]; watchAll(a, 8);
trace("splice(3)"); a.splice(3);
a = [0, 1, 2]; watchAll(a, 8);
trace("sort desc"); a.sort(2);
a = [2, 0, 1]; watchAll(a, 8);
trace("sort"); a.sort();
a = [0, 1, 2]; watchAll(a, 8);
trace("unshift(x)"); a.unshift("x");
a = [0, 1, 2]; watchAll(a, 8);
trace("shift"); a.shift();
a = [0, 1, 2]; watchAll(a, 8);
trace("pop"); a.pop();
a = [0, 1, 2]; watchAll(a, 8);
trace("push(x,y)"); a.push("x", "y");
a = [0, 1, 2, 3]; watchAll(a, 8);
trace("reverse"); a.reverse();
a = [0, 1, 2]; watchAll(a, 8);
trace("slice"); a.slice(1);
trace("concat"); a.concat([5]);
var s = [1, 2, 3];
s.addProperty("0", function () { trace("  get0"); return "G"; }, function (v) { trace("  set0 " + v); });
trace("setter reverse"); s.reverse();
trace("s " + s.join());
s = [1, 2, 3];
s.addProperty("0", function () { trace("  get0"); return "G"; }, function (v) { trace("  set0 " + v); });
trace("setter sort"); s.sort();
trace("s " + s.join());
trace("setter slice " + s.slice(0, 1));
trace("setter concat " + s.concat());
trace("setter pop " + s.pop());
trace("setter shift " + s.shift());
trace("s " + s.join());
var a = [0, 1, 2]; watchAll(a, 8);
trace("unshift(x,y)"); a.unshift("x", "y");
a = [0, 1, 2]; watchAll(a, 8);
trace("unshift()"); a.unshift();
a = []; watchAll(a, 8);
trace("unshift(x) empty"); a.unshift("x");
a = []; watchAll(a, 8);
trace("shift empty"); a.shift();
a = [0]; watchAll(a, 8);
trace("splice(0,0)"); a.splice(0, 0);
var o = {length: 2, 0: "a", 1: "b"};
trace("unshift obj"); Array.prototype.unshift.call(o, "c");
trace("shift obj " + Array.prototype.shift.call(o));
trace("o " + o.length + " " + o[0] + " " + o[1]);
