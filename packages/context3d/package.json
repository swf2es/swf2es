{
  "name": "@swf2es/context3d",
  "version": "0.1.22",
  "description": "Experimental Context3D resource contracts, AGAL translation and an optional WebGL2 backend",
  "keywords": [
    "flash",
    "stage3d",
    "context3d",
    "agal",
    "webgl2"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/context3d"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "types": "./dist/device/index.d.ts",
      "default": "./dist/device/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "default": "./dist/webgl/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src"
  ]
}
