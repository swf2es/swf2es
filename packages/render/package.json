{
  "name": "@swf2es/render",
  "version": "0.1.20",
  "description": "swf2es's own renderer: a scene list, a planner and a WebGL 2 backend (docs/renderer.md)",
  "keywords": [
    "swf",
    "flash",
    "renderer",
    "webgl2"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/render"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "default": "./dist/webgl/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src"
  ],
  "dependencies": {
    "@swf2es/context3d": "workspace:*"
  }
}
