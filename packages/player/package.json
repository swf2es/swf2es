{
  "name": "@swf2es/player",
  "version": "0.1.0",
  "description": "Browser SWF player: display list, timeline, playerglobal and renderer adapters",
  "keywords": [
    "swf",
    "flash",
    "flash-player",
    "actionscript",
    "player",
    "webgl2"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/player"
  },
  "license": "Apache-2.0 AND (Apache-2.0 OR MIT) AND W3C-20150513",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context3d": {
      "types": "./dist/playerglobal/context3d.d.ts",
      "default": "./dist/playerglobal/context3d.js"
    },
    "./libraries": {
      "types": "./dist/playerglobal/libraries.d.ts",
      "default": "./dist/playerglobal/libraries.js"
    },
    "./scene": {
      "types": "./dist/scene/view.d.ts",
      "default": "./dist/scene/view.js"
    },
    "./worker": {
      "types": "./dist/workers/thread.d.ts",
      "default": "./dist/workers/thread.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "LICENSE.third-party"
  ],
  "dependencies": {
    "@swf2es/context3d": "workspace:*",
    "@swf2es/codegen": "workspace:*",
    "@swf2es/format": "workspace:*",
    "@swf2es/runtime": "workspace:*",
    "@swf2es/native": "workspace:*",
    "@swf2es/render": "workspace:*"
  }
}
