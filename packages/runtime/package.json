{
  "name": "@swf2es/runtime",
  "version": "0.1.22",
  "description": "AVM2 and AVM1 language runtime used by generated code",
  "keywords": [
    "actionscript",
    "as3",
    "as2",
    "avm1",
    "avm2",
    "flash",
    "runtime"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/runtime"
  },
  "license": "Apache-2.0 AND MPL-2.0 AND (Apache-2.0 OR MIT)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./avm2": {
      "types": "./dist/avm2/index.d.ts",
      "default": "./dist/avm2/index.js"
    },
    "./avm1": {
      "types": "./dist/avm1/index.d.ts",
      "default": "./dist/avm1/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "LICENSE.third-party"
  ],
  "dependencies": {
    "@swf2es/format": "workspace:*"
  }
}
