{
  "name": "@swf2es/web",
  "version": "0.1.19",
  "description": "Plays SWFs on any web page: the <swf2es-player> element, replaceFlash and ExternalInterface",
  "keywords": [
    "swf",
    "flash",
    "flash-player",
    "embed",
    "custom-element",
    "actionscript",
    "player"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/web"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src"
  ],
  "dependencies": {
    "@swf2es/codegen": "workspace:*",
    "@swf2es/format": "workspace:*",
    "@swf2es/player": "workspace:*",
    "@swf2es/player-hosts": "workspace:*"
  }
}
