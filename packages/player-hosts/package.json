{
  "name": "@swf2es/player-hosts",
  "version": "0.1.1",
  "description": "Optional Node and WebSocket transports, worker threads, an IndexedDB module cache and precompiled modules for the swf2es player",
  "keywords": [
    "swf",
    "flash",
    "player",
    "websocket",
    "web-worker",
    "indexeddb"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/player-hosts"
  },
  "license": "Apache-2.0 AND (Apache-2.0 OR MIT) AND MPL-2.0 AND W3C-20150513 AND Zlib AND LicenseRef-LZMA-SDK-Public-Domain AND CC0-1.0 AND SGI-B-2.0 AND BSD-2-Clause AND MIT",
  "type": "module",
  "exports": {
    "./stage3d": {
      "types": "./dist/stage3d.d.ts",
      "default": "./dist/stage3d.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "default": "./dist/indexeddb.js"
    },
    "./precompiled": {
      "types": "./dist/precompiled.d.ts",
      "default": "./dist/precompiled.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "default": "./dist/workers.js"
    },
    "./web-worker": {
      "types": "./dist/web-worker.d.ts",
      "default": "./dist/web-worker.js"
    },
    "./node-worker": {
      "types": "./dist/node-worker.d.ts",
      "default": "./dist/node-worker.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "default": "./dist/websocket.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "LICENSE.third-party"
  ],
  "dependencies": {
    "@swf2es/player": "workspace:*"
  }
}
