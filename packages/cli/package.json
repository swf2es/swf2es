{
  "name": "@swf2es/cli",
  "version": "0.0.0",
  "description": "swf2es command line: ahead-of-time compile SWF and ABC files",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@swf2es/format": "workspace:*",
    "@swf2es/codegen": "workspace:*"
  },
  "bin": {
    "swf2es": "./dist/main.js"
  }
}
