{
  "name": "@swf2es/cli",
  "version": "0.1.9",
  "description": "swf2es command line: ahead-of-time compile SWF and ABC files, and run ABCs as avmshell does",
  "keywords": [
    "swf",
    "flash",
    "actionscript",
    "as3",
    "abc",
    "avmshell",
    "compiler",
    "aot",
    "cli"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0 AND MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "swf2es": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "LICENSE.third-party"
  ],
  "dependencies": {
    "@swf2es/format": "workspace:*",
    "@swf2es/codegen": "workspace:*",
    "@swf2es/player": "workspace:*",
    "@swf2es/runtime": "workspace:*"
  }
}
