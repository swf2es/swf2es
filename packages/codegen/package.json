{
  "name": "@swf2es/codegen",
  "version": "0.1.38",
  "description": "ABC and AVM1 bytecode to ES module compiler (Zig → wasm); identical output in JIT and AOT modes",
  "keywords": [
    "swf",
    "flash",
    "actionscript",
    "avm1",
    "avm2",
    "abc",
    "compiler",
    "webassembly"
  ],
  "homepage": "https://swf2es.github.io/swf2es/",
  "bugs": "https://github.com/swf2es/swf2es/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swf2es/swf2es.git",
    "directory": "packages/codegen"
  },
  "license": "Apache-2.0 AND (Apache-2.0 OR MIT) AND MIT AND BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codegen.wasm": "./dist/codegen.wasm"
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "LICENSE.third-party"
  ],
  "dependencies": {
    "@swf2es/format": "workspace:*"
  },
  "scripts": {
    "build:wasm": "node zig/build.ts",
    "build:zig": "node zig/build.ts --update"
  }
}
