{
  "name": "@swf2es/native",
  "version": "0.0.0",
  "description": "swf2es's WebAssembly modules: bitmap kernels, MP3 decoding, zlib and LZMA, and fill tessellation",
  "license": "Apache-2.0 AND Zlib AND LicenseRef-LZMA-SDK-Public-Domain AND CC0-1.0 AND SGI-B-2.0",
  "type": "module",
  "exports": {
    "./bitmap": {
      "types": "./dist/bitmap/index.d.ts",
      "default": "./dist/bitmap/index.js"
    },
    "./compress": {
      "types": "./dist/compress/index.d.ts",
      "default": "./dist/compress/index.js"
    },
    "./mp3": {
      "types": "./dist/mp3/index.d.ts",
      "default": "./dist/mp3/index.js"
    },
    "./strokes": {
      "types": "./dist/strokes/index.d.ts",
      "default": "./dist/strokes/index.js"
    },
    "./tessellate": {
      "types": "./dist/tessellate/index.d.ts",
      "default": "./dist/tessellate/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.third-party"
  ],
  "scripts": {
    "build:wasm": "node build.ts",
    "check:wasm": "node build.ts --check"
  }
}
