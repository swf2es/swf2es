{
  "name": "@swf2es/native",
  "version": "0.0.0",
  "description": "swf2es's WebAssembly modules: bitmap kernels, MP3 decoding, zlib and LZMA, fill and line tessellation, and ATF textures",
  "license": "Apache-2.0 AND Zlib AND LicenseRef-LZMA-SDK-Public-Domain AND CC0-1.0 AND SGI-B-2.0 AND BSD-2-Clause",
  "type": "module",
  "exports": {
    "./atf": {
      "types": "./dist/atf/index.d.ts",
      "default": "./dist/atf/index.js"
    },
    "./compress": {
      "types": "./dist/compress/index.d.ts",
      "default": "./dist/compress/index.js"
    },
    "./mp3": {
      "types": "./dist/mp3/index.d.ts",
      "default": "./dist/mp3/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.third-party"
  ],
  "scripts": {
    "build:wasm": "node build.ts",
    "check:wasm": "node build.ts --check"
  }
}
